<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/vxeno_card_server"
    android:padding="16dp">

    <TextView
        android:id="@+id/vxeno_server_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NewEra"
        android:textColor="@color/vxeno_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/vxeno_server_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/vxeno_dot_green"
        android:layout_marginStart="10dp"
        app:layout_constraintTop_toTopOf="@+id/vxeno_server_name"
        app:layout_constraintBottom_toBottomOf="@+id/vxeno_server_name"
        app:layout_constraintStart_toEndOf="@+id/vxeno_server_name" />

    <TextView
        android:id="@+id/vxeno_server_online"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Онлайн: 24/100"
        android:textColor="@color/vxeno_online_green"
        android:textSize="13sp"
        android:layout_marginStart="6dp"
        app:layout_constraintTop_toTopOf="@+id/vxeno_server_name"
        app:layout_constraintBottom_toBottomOf="@+id/vxeno_server_name"
        app:layout_constraintStart_toEndOf="@+id/vxeno_server_dot" />

    <TextView
        android:id="@+id/vxeno_server_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Индустриально-магический сервер нового поколения (1.20.1 Fabric)"
        android:textColor="@color/vxeno_text_secondary"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@+id/vxeno_server_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/vxeno_btn_optional_mods"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/vxeno_card_server"
        android:text="Моды"
        android:textColor="@color/vxeno_accent_light"
        android:textSize="12sp"
        android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@+id/vxeno_server_desc"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/vxeno_btn_play_server"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/vxeno_btn_gradient"
        android:text="ИГРАТЬ ▶"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:layout_constraintTop_toTopOf="@+id/vxeno_btn_optional_mods"
        app:layout_constraintBottom_toBottomOf="@+id/vxeno_btn_optional_mods"
        app:layout_constraintStart_toEndOf="@+id/vxeno_btn_optional_mods"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>