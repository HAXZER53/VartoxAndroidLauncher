<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vxeno_main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vxeno_bg">

    <!-- TopBar with 3 Navigation Tabs: Profile, Servers, Settings -->
    <LinearLayout
        android:id="@+id/vxeno_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="@color/vxeno_card_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/vxeno_tab_account"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="50dp"
            android:background="@drawable/vxeno_top_bar_unselected"
            android:drawableStart="@drawable/ic_navigation_account"
            android:drawablePadding="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/vxeno_text_primary"
            android:textAllCaps="false"
            android:text="Профиль" />

        <Button
            android:id="@+id/vxeno_tab_servers"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/vxeno_top_bar_selected"
            android:drawableStart="@drawable/ic_menu_home"
            android:drawablePadding="6dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/vxeno_text_primary"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:text="Серверы" />

        <Button
            android:id="@+id/vxeno_tab_settings"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="50dp"
            android:background="@drawable/vxeno_top_bar_unselected"
            android:drawableStart="@drawable/ic_menu_settings"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- Main Dynamic Content Fragment Container -->
    <FrameLayout
        android:id="@+id/vxeno_content_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/vxeno_top_bar"
        app:layout_constraintBottom_toTopOf="@+id/vxeno_downloader_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CubixWorld-style Downloader Row at Bottom -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/vxeno_downloader_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vxeno_card_bg"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/vxeno_download_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Синхронизация клиента..."
            android:textColor="@color/vxeno_text_primary"
            android:textStyle="bold"
            android:textSize="14sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/vxeno_download_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="@color/vxeno_accent_light"
            android:textStyle="bold"
            android:textSize="14sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ProgressBar
            android:id="@+id/vxeno_download_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            app:layout_constraintTop_toBottomOf="@+id/vxeno_download_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/vxeno_download_cancel" />

        <Button
            android:id="@+id/vxeno_download_cancel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="#D32F2F"
            android:text="Отмена"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textAllCaps="false"
            app:layout_constraintBottom_toBottomOf="@+id/vxeno_download_progress"
            app:layout_constraintTop_toTopOf="@+id/vxeno_download_progress"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>